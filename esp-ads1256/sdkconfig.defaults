# App membesar karena WiFi + TLS + HTTP server
CONFIG_PARTITION_TABLE_SINGLE_APP_LARGE=y
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
# Header browser iOS/Android sering > 512 byte
CONFIG_HTTPD_MAX_REQ_HDR_LEN=1024
CONFIG_HTTPD_MAX_URI_LEN=1024
# Buffer kirim TCP: ≥ 3 paket v3 (~4.6 KB). 32 KB menghabiskan heap saat TLS
# tersambung (sisa ~36 KB) dan koneksi putus; 16 KB cukup untuk ~45 KB/s.
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=16384
# Buffer mbedTLS dialokasikan hanya saat dipakai (hemat ~20 KB heap).
CONFIG_MBEDTLS_DYNAMIC_BUFFER=y
# Task WS (baca/ping) tidak memegang kunci yang sama dengan pengirim data.
CONFIG_ESP_WS_CLIENT_SEPARATE_TX_LOCK=y
# Core 1 dipakai penuh akuisisi ADS (prio 20, 15k RDATA/s); tcpip (prio 18) tanpa afinitas
# ikut ke sana dan kelaparan → TCP lambat (~1k sampel/s sampai backend).
CONFIG_LWIP_TCPIP_TASK_AFFINITY_CPU0=y
# Jalur hotspot seluler sering ber-MTU < 1500 (lwIP tanpa PMTU discovery): segmen penuh
# 1440 B hilang diam-diam, data besar macet sementara pesan kecil lolos.
CONFIG_LWIP_TCP_MSS=1200
